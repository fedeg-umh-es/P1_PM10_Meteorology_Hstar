__pycache__/
*.pyc
.DS_Store
data_raw/*
data_processed/*
results/*
figures/*
!data_raw/.gitkeep
!data_processed/.gitkeep
!results/.gitkeep
!figures/.gitkeep
# Allow rvvcca subdirectory structure (data files remain ignored)
!data_raw/rvvcca/
data_raw/rvvcca/*
!data_raw/rvvcca/.gitkeep
!data_raw/rvvcca/official_drop/
data_raw/rvvcca/official_drop/*
!data_raw/rvvcca/official_drop/.gitkeep
