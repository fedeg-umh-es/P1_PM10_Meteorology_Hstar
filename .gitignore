__pycache__/
*.pyc
.DS_Store
.claude/
code/eval "$(ssh-agent -s)"*
data_raw/*
data_processed/*
results/*
figures/*
!data_raw/.gitkeep
!data_processed/.gitkeep
!results/.gitkeep
!figures/.gitkeep
# Ireland evidence recovery: frozen documentary artifacts only (config
# snapshot, reconstructed metadata, manifests, manuscript-claim comparison
# table, validation report). No raw predictions/metrics/stats are tracked
# here, consistent with the "do not track by default" policy in
# reports/output_versioning_policy.md.
!results/e2_met_ireland_pm10/
!results/e2_met_ireland_pm10/**
# Ireland evidence regeneration (from recovered source CSVs, 2026-07-26):
# unlike results/e2_met_ireland_pm10/ above, this regenerated run's raw
# predictions/metrics/stats ARE tracked, because they are the row-level
# evidence this regeneration exists to produce -- see
# results/e2_met_ireland_pm10_regenerated/README.md.
!results/e2_met_ireland_pm10_regenerated/
!results/e2_met_ireland_pm10_regenerated/**
# Per-station-condition prediction files are a strict subset of
# predictions/predictions_all_models.csv (same rows, already merged) --
# tracking both would duplicate ~14MB of row-level data for no additional
# evidentiary value, so only the combined file is tracked.
results/e2_met_ireland_pm10_regenerated/predictions/predictions_*_lags_*.csv
# The 8 recovered source CSVs and per-station shard scratch directories are
# never tracked (large, not the manuscript-facing artifact; manifest with
# hashes is tracked instead).
results/_ireland_regen_shards/
# Allow rvvcca subdirectory structure (data files remain ignored)
!data_raw/rvvcca/
data_raw/rvvcca/*
!data_raw/rvvcca/.gitkeep
!data_raw/rvvcca/official_drop/
data_raw/rvvcca/official_drop/*
!data_raw/rvvcca/official_drop/.gitkeep

# Raw data — not tracked (large files, public sources)
# Download instructions: see README.md under Data Sources
data_raw/

# Python cache
__pycache__/
*.pyc
*.pyo

# Audit venv (local, reproducible via docs/audit/00_inventory.md)
.venv_audit/
